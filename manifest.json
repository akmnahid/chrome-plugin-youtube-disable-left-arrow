{
  "manifest_version": 3,
  "name": "ForwardOnly for YouTube",
  "version": "1.0",
  "description": "Disables the left arrow key on YouTube videos to prevent rewinding.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}